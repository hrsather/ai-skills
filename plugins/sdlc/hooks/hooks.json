{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-handoff.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-push-checks.sh\"",
            "if": "Bash(git *)",
            "timeout": 600,
            "statusMessage": "Running pre-push checks..."
          }
        ]
      }
    ]
  }
}
